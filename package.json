{
  "name": "tally",
  "version": "0.1.0",
  "private": true,
  "description": "A street counter that runs in the browser: detection on WebGPU, tracking and line counts, scored against labelled traffic footage.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iliev-blnk/tally.git"
  },
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "license": "MIT",
  "author": "Ilie Beleniuc",
  "scripts": {
    "dev": "vite site",
    "build": "vite build site",
    "preview": "vite preview site",
    "models": "tsx scripts/models.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@webgpu/types": "^0.1.74",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  }
}
